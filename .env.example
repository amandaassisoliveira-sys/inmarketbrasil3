# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# NUNCA suba o arquivo ".env" para o Git.

MOCK_MODE=true

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

DHL_API_KEY=
DHL_API_SECRET=

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

# Login por link mágico
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-longa
# SITE_URL é a URL do SITE publicado (Netlify), não do backend — é pra lá que
# o link do email deve levar, já que o site que troca o token pelo acesso.
SITE_URL=https://seu-site.netlify.app

# Email (Resend) — deixe em branco para testar sem enviar email de verdade
# (o link aparece direto na resposta da API em modo de desenvolvimento)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Banco de dados — no Railway, adicione o plugin PostgreSQL e ele preenche
# essa variável sozinho. Localmente, pode deixar em branco (usa SQLite).
DATABASE_URL=
